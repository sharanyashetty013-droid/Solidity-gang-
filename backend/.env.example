# ── Chain ──────────────────────────────────────────
RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY      # or Alchemy / any Sepolia RPC
CHAIN_ID=11155111
CONTRACT_ADDRESS=0xYourDeployedRentalEscrow
DEPLOY_BLOCK=0                                      # block the contract was deployed at (faster event scans)
EVENT_CHUNK=9000                                    # lower if your RPC limits getLogs range

# ── Secrets ────────────────────────────────────────
ENCRYPTION_KEY=                                     # openssl rand -hex 32   (64 hex chars)
PINATA_JWT=                                         # leave empty for LOCAL MOCK storage (dev only)
PINATA_GATEWAY=https://gateway.pinata.cloud
PINATA_GATEWAY_TOKEN=

# ── Behaviour ──────────────────────────────────────
PORT=3001
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
GEO_RADIUS_METERS=150
DEFAULT_PROPERTY_LAT=                               # optional fallback property location for demos
DEFAULT_PROPERTY_LNG=
REQUIRE_CAPTURE_AUTH=true
DATA_DIR=./data
